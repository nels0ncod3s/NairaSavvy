# Public website origin (used in confirmation links and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=
SENDBYTE_API_KEY=
SENDBYTE_FROM_EMAIL=
# Optional deployment webhook; keep both values server-only
CONTENT_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# Agent pipeline (off by default; see docs/agent-pipeline.md)
AGENTS_SEND_ENABLED=false
SENDBYTE_WEBHOOK_SECRET=
# Bayo source-only mode needs no AI credentials; ai uses OpenAI Responses.
BAYO_MODE=source
OPENAI_API_KEY=
# Set a model supporting Structured Outputs in Responses when using ai mode.
BAYO_MODEL=
